# Copy to .env (never commit .env) and fill in. ax_load.py reads it automatically.

# SQL Server holding the Dynamics AX business database
MSSQL_HOST=192.168.11.59
MSSQL_PORT=1433
MSSQL_USER=dharani
MSSQL_PASS=
MSSQL_DB=MicrosoftDynamicsAX
# this server only speaks TDS 7.0 / TLS 1.0 (see schema_dump.py)
MSSQL_TDS_VERSION=7.0

# ClickHouse HTTP interface
CH_URL=http://localhost:8123/
CH_USER=default
CH_PASSWORD=

# ---- web app sign-in (webapp/auth.py) -- all optional -------------------------
# The address people open. E-mailed links are built from it; needed for
# "Forgot password" and for Google / Microsoft sign-in (which require https).
APP_BASE_URL=
# E-mail for invitations and password resets.
#   Gmail:          SMTP_HOST=smtp.gmail.com     SMTP_PORT=587  (use an app password)
#   Microsoft 365:  SMTP_HOST=smtp.office365.com SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# "Continue with Google": redirect URI <APP_BASE_URL>/api/auth/oidc/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "Continue with Microsoft": redirect URI <APP_BASE_URL>/api/auth/oidc/microsoft/callback
# MS_TENANT: your tenant id (PUC accounts only), organizations, or common
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=organizations
