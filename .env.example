# Copy to .env (never commit .env) and fill in. ax_load.py reads it automatically.

# SQL Server holding the Dynamics AX business database
MSSQL_HOST=192.168.11.88
MSSQL_PORT=1433
MSSQL_USER=dharani
MSSQL_PASS=
MSSQL_DB=MicrosoftDynamicsAX
# this server only speaks TDS 7.0 / TLS 1.0 (see schema_dump.py)
MSSQL_TDS_VERSION=7.0

# ClickHouse HTTP interface
CH_URL=http://localhost:8123/
CH_USER=default
CH_PASSWORD=
