	partition Billing = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        Web.Contents(ClickHouseUrl, [
				            Query = [query = "SELECT period, utility_code, region_code, tariff_code, charge_key, customer_id, connection_id, meter_id, invoice_id, invoice_prefix, water_source, water_node, pv_connection, unit, amount, quantity, consumption_qty, consumption_amount, adjustment_amount, adjustment_qty, credit_amount, has_meter FROM ub.pbi_billing FORMAT CSVWithNames", user = ClickHouseUser, password = ClickHousePassword],
				            Timeout = #duration(0, 0, 30, 0)]),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"period", type date}, {"utility_code", Int64.Type}, {"region_code", Int64.Type}, {"tariff_code", type text}, {"charge_key", type text}, {"customer_id", type text}, {"connection_id", type text}, {"meter_id", type text}, {"invoice_id", type text}, {"invoice_prefix", type text}, {"water_source", type text}, {"water_node", type text}, {"pv_connection", Int64.Type}, {"unit", type text}, {"amount", type number}, {"quantity", type number}, {"consumption_qty", type number}, {"consumption_amount", type number}, {"adjustment_amount", type number}, {"adjustment_qty", type number}, {"credit_amount", type number}, {"has_meter", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
