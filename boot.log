 trans_type_name LowCardinality(String) ALIAS transform(trans_type, [2, 15], ['Invoice', 'Payment'], concat('code_', toString(trans_type))) ) ENGINE = ReplacingMergeTree(modified) ORDER BY (data_area, cust_account, trans_date, recid); (stage: Complete)
