 CREATE TABLE IF NOT EXISTS ax.cust_trans ( data_area LowCardinality(String), cust_account String, -- ACCOUNTNUM -> customers.customer_id
 customer_group LowCardinality(String), -- CUSTTABLE.CUSTGROUP
 trans_date DateTime64(3), due_date DateTime64(3), -- AX writes 1900-01-01 into CLOSED while a transaction is still outstanding.
 closed DateTime64(3), voucher String, invoice String, txt String, -- free-text description on the posting
 amount_cur Decimal(32, 16), -- transaction currency
