 settle_cur Decimal(32, 16), -- SETTLEAMOUNTCUR: how much was settled
 settle_mst Decimal(32, 16), currency LowCardinality(String), trans_type UInt8, -- AX LedgerTransType
 partition_id Int64, recid Int64, created DateTime64(3), modified DateTime64(3), is_open UInt8 ALIAS toUInt8(toYear(closed) <= 1900), open_amount Decimal(32, 16) ALIAS amount_mst - settle_mst, days_overdue Int32 ALIAS if(is_open = 0, 0, toInt32(dateDiff('day', due_date, now()))), -- Read off this instance's data, not a guessed enum table: type 2 is positive
