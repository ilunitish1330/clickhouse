 -- Sales side, built from SALESTABLE / SALESLINE / CUSTTABLE / CUSTTRANS only.
 -- Dimension attributes are DENORMALIZED onto every fact row rather than joined at
 -- query time: LowCardinality(String) stores each distinct value once, so the
 -- duplication is nearly free and it removes a join the query layer can get wrong.
 --
 -- SALESTABLE and SALESLINE carry CUSTGROUP natively, so the customer-group
 -- dimension needs no join at all. CUSTTRANS does not, so it takes its group from
 -- CUSTTABLE -- the only join in here, and it stays inside the four tables.
 --
 -- ponytail: AX integer enums are decoded with ALIAS columns, not stored ones. An
 -- ALIAS costs zero bytes, computes on read, and still shows up in system.columns --
 -- which is where the natural-language layer reads the schema from.
 --
 -- No customer NAME column: names live in DIRPARTYTABLE, which is out of scope here.
 -- Join ax.customers on (data_area, cust_account) when a query needs to show one.
 -- =============================================================================
 -- SALESTABLE (14590). Grain: one sales order header.
 CREATE TABLE IF NOT EXISTS ax.sales_orders ( data_area LowCardinality(String), sales_id String, -- SALESID
 sales_name String, -- SALESNAME
 cust_account String, -- CUSTACCOUNT -> customers.customer_id
 invoice_account String, customer_group LowCardinality(String), -- SALESTABLE.CUSTGROUP, native
 currency LowCardinality(String), payment_terms LowCardinality(String), -- SALESTABLE.PAYMENT
 sales_status UInt8, document_status UInt8, delivery_date DateTime64(3), partition_id Int64, recid Int64, created DateTime64(3), modified DateTime64(3), sales_status_name LowCardinality(String) ALIAS transform(sales_status, [1, 2, 3, 4], ['Backorder', 'Delivered', 'Invoiced', 'Canceled'], 'None'), -- Unmapped codes render as 'code_7', not as a catch-all label. A wrong label
 -- is worse than a visible gap: this instance puts 14318 of 14590 orders on
 -- code 7, which a generic AX enum map silently called 'None'.
 document_status_name LowCardinality(String) ALIAS transform(document_status, [0, 3, 4, 5], ['None', 'Invoice', 'Quotation', 'Confirmation'], concat('code_', toString(document_status))) ) ENGINE = ReplacingMergeTree(modified) ORDER BY (data_area, sales_id); (stage: Complete)
