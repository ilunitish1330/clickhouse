 -- carries no amount. It also carries COSTPRICE, which the purchase side has no
 -- equivalent of, so margin is answerable here.
 CREATE TABLE IF NOT EXISTS ax.sales_lines ( data_area LowCardinality(String), sales_id String, -- -> sales_orders.sales_id
 line_num Decimal(32, 16), -- LINENUM is numeric in AX, not an int
 item_id String, -- ITEMID
 item_name String, -- SALESLINE.NAME, native to the line
 sales_status UInt8, qty_ordered Decimal(32, 16), sales_price Decimal(32, 16), -- unit price
 cost_price Decimal(32, 16), -- unit cost
 line_amount Decimal(32, 16), -- revenue; sum THIS, not price * qty
 line_disc Decimal(32, 16), line_percent Decimal(32, 16), currency LowCardinality(String), cust_account String, customer_group LowCardinality(String), -- SALESLINE.CUSTGROUP, native
 invent_trans_id String, -- INVENTTRANSID, the AX line key
 ship_date DateTime64(3), -- SHIPPINGDATEREQUESTED
 partition_id Int64, recid Int64, created DateTime64(3), modified DateTime64(3), sales_status_name LowCardinality(String) ALIAS transform(sales_status, [1, 2, 3, 4], ['Backorder', 'Delivered', 'Invoiced', 'Canceled'], 'None'), -- Gross margin. line_amount is already net of discount; cost is per unit.
 -- ponytail: Float64, not Decimal. Decimal(32,16) * Decimal(32,16) wants 32 decimal
 -- places and overflows ClickHouse's precision ceiling. Float64 carries ~15
 -- significant digits, exact to the cent at these magnitudes, and this is a derived
 -- analytic column -- the stored amounts stay Decimal.
 margin Float64 ALIAS toFloat64(line_amount) - toFloat64(cost_price) * toFloat64(qty_ordered), margin_pct Float64 ALIAS if(line_amount = 0, 0, margin / toFloat64(line_amount) * 100) ) ENGINE = ReplacingMergeTree(modified) ORDER BY (data_area, sales_id, line_num, recid); (stage: Complete)
